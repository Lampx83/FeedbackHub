# ── Feedback Hub: cấu hình ─────────────────────────────────────────────────────────
# Sao chép thành .env rồi sửa. KHÔNG commit .env.
# Sinh chuỗi ngẫu nhiên mạnh:  openssl rand -base64 32

# Mật khẩu PostgreSQL (docker compose dùng cho container db).
POSTGRES_PASSWORD=

# Khoá ký cookie đăng nhập bảng điều khiển. Đổi khoá = mọi người đăng nhập lại.
AUTH_SECRET=

# Khoá mã hoá các khoá ký token của từng dự án trong DB (AES-256-GCM).
# ⚠️ MẤT khoá này là mất toàn bộ khoá ký của mọi dự án (phải cấp lại từng cái); ĐỔI khoá cũng vậy.
# Hãy sao lưu nó cùng nơi với bản sao lưu DB nhưng KHÔNG cùng một tệp.
HUB_ENCRYPTION_KEY=

# Tài khoản quản trị đầu tiên, tạo lúc khởi động nếu chưa có ai. Sau khi đăng nhập được, có thể xoá hai dòng này.
HUB_ADMIN_EMAIL=
HUB_ADMIN_PASSWORD=

# Địa chỉ công khai của hub (có https). Dùng để in đoạn mã nhúng cho đúng.
HUB_PUBLIC_URL=https://feedback.example.com

# Đường dẫn con nếu hub chạy dưới tên miền dùng chung (vd. /feedbackhub). Đổi thì phải build lại. Để trống = chạy ở gốc.
HUB_BASE_PATH=
# Cổng trên máy chủ (chỉ mở cho localhost).
HUB_PORT=3100

# ── Thông báo email (tuỳ chọn) ─────────────────────────────────────────────────────
# Có SMTP thì mỗi dự án có thể nhận email khi có góp ý mới/trả lời. Không đặt = chỉ chuông trong bảng điều khiển + webhook chat.
# HUB_SMTP_URL=smtps://user:matkhau@smtp.example.com:465
# HUB_MAIL_FROM="Feedback Hub <feedback@example.com>"

# ── Mạng ───────────────────────────────────────────────────────────────────────────
# Số proxy tin cậy đứng trước hub (nginx/Caddy = 1; thêm Cloudflare = 2; chạy thẳng không proxy = 0).
# Dùng để biết đúng IP máy khách cho giới hạn tần suất. Đặt sai (quá nhỏ) thì mọi người dùng chung một bộ đếm.
# HUB_TRUSTED_PROXY_HOPS=1
# Cho phép webhook thông báo trỏ tới địa chỉ nội bộ/http (chỉ bật khi hub chạy trong mạng riêng và bạn tin mọi quản trị viên).
# HUB_ALLOW_PRIVATE_WEBHOOKS=1

# ── Chỉ khi chạy KHÔNG qua docker compose (npm run dev / npm start) ────────────────
# DATABASE_URL=postgresql://hub:matkhau@localhost:5432/feedbackhub
# HUB_DATA_DIR=./data
