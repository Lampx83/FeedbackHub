# nginx: đặt vào /etc/nginx/sites-available/feedback, bật HTTPS bằng certbot (`certbot --nginx -d feedback.example.com`).
server {
    listen 80;
    server_name feedback.example.com;

    client_max_body_size 12m;

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Hub dùng X-Forwarded-For để giới hạn tần suất theo địa chỉ người gửi — phải đặt đúng.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
